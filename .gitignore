# Python
__pycache__/
*.pyc

# Screen recordings: too big for git (GitHub refuses files over 100 MB)
*.mp4
*.mkv
*.mov

# Generated by run.bat / report.py: rebuilt from fm.db on every run
results/
report.html
site/
review_names.csv

# Icon cache: downloaded again automatically when missing
icons/

# Price history. It holds other players' character and shop names, so it stays out of a
# public repo. Delete this line if the repo is private and you want git to back it up.
fm.db
